# CockroachDB Connection String (PostgreSQL-compatible)
DATABASE_URL="postgresql://username:password@cluster-name.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# AWS Configuration & Amazon Bedrock Access
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# CockroachDB Cloud Managed MCP & CLI Config
COCKROACH_MCP_URL="https://cockroachlabs.cloud/mcp"
CCLOUD_API_KEY="your-ccloud-api-key"
